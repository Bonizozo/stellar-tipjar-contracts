{
  "contract": "TipJarContract",
  "functions": [
    {
      "name": "init",
      "doc": "One-time configuration of the token this jar accepts and its admin.\nErrors if called twice.",
      "params": [
        {
          "name": "token",
          "ty": "Address"
        },
        {
          "name": "admin",
          "ty": "Address"
        }
      ],
      "returns": "()"
    },
    {
      "name": "tip",
      "doc": "Escrows `amount` of the configured token from `sender` for `creator`,\nless the protocol fee (if one is configured). The creator's balance is\ncredited with `amount - fee`; the fee itself accrues to `FeeBalance`\nfor later withdrawal by the fee collector. `fee + net == amount` holds\nfor every input.",
      "params": [
        {
          "name": "sender",
          "ty": "Address"
        },
        {
          "name": "creator",
          "ty": "Address"
        },
        {
          "name": "amount",
          "ty": "i128"
        }
      ],
      "returns": "()"
    },
    {
      "name": "get_total_tips",
      "doc": "Historical total ever tipped to `creator`. Zero if the creator has never been tipped.",
      "params": [
        {
          "name": "creator",
          "ty": "Address"
        }
      ],
      "returns": "i128"
    },
    {
      "name": "withdraw",
      "doc": "Pays out a creator's full or partial withdrawable balance.\nIf caller is an operator, checks their allowance and expiry.\nApplies any matured payout address change before transferring.",
      "params": [
        {
          "name": "caller",
          "ty": "Address"
        },
        {
          "name": "creator",
          "ty": "Address"
        },
        {
          "name": "to",
          "ty": "Address"
        },
        {
          "name": "amount",
          "ty": "Option<i128>"
        }
      ],
      "returns": "()"
    },
    {
      "name": "set_payout_address",
      "doc": "",
      "params": [
        {
          "name": "creator",
          "ty": "Address"
        },
        {
          "name": "payout",
          "ty": "Address"
        }
      ],
      "returns": "()"
    },
    {
      "name": "cancel_payout_address",
      "doc": "",
      "params": [
        {
          "name": "creator",
          "ty": "Address"
        }
      ],
      "returns": "()"
    },
    {
      "name": "authorize_operator",
      "doc": "",
      "params": [
        {
          "name": "creator",
          "ty": "Address"
        },
        {
          "name": "operator",
          "ty": "Address"
        },
        {
          "name": "allowance",
          "ty": "i128"
        },
        {
          "name": "expiry_ledger",
          "ty": "u32"
        }
      ],
      "returns": "()"
    },
    {
      "name": "revoke_operator",
      "doc": "",
      "params": [
        {
          "name": "creator",
          "ty": "Address"
        },
        {
          "name": "operator",
          "ty": "Address"
        }
      ],
      "returns": "()"
    },
    {
      "name": "set_fee",
      "doc": "Sets the protocol fee rate and its collector. Admin-only; `bps` is\nhard-capped at `MAX_FEE_BPS`. Setting `bps` to 0 disables fees.",
      "params": [
        {
          "name": "caller",
          "ty": "Address"
        },
        {
          "name": "bps",
          "ty": "u32"
        },
        {
          "name": "collector",
          "ty": "Address"
        }
      ],
      "returns": "()"
    },
    {
      "name": "withdraw_fees",
      "doc": "Pays out the fee collector's full or partial share of `FeeBalance`.\nMirrors `withdraw`'s pattern, including TTL extension.",
      "params": [
        {
          "name": "caller",
          "ty": "Address"
        },
        {
          "name": "amount",
          "ty": "Option<i128>"
        }
      ],
      "returns": "()"
    },
    {
      "name": "propose_admin",
      "doc": "Proposes `new_admin` as the next admin. Takes effect only once\n`new_admin` calls `accept_admin`, so a typoed address can't brick\ngovernance. Admin-only.",
      "params": [
        {
          "name": "caller",
          "ty": "Address"
        },
        {
          "name": "new_admin",
          "ty": "Address"
        }
      ],
      "returns": "()"
    },
    {
      "name": "accept_admin",
      "doc": "Completes a two-step admin transfer. Callable only by the address\ncurrently proposed as the pending admin.",
      "params": [
        {
          "name": "caller",
          "ty": "Address"
        }
      ],
      "returns": "()"
    },
    {
      "name": "cancel_admin_transfer",
      "doc": "Abandons a pending admin transfer, leaving the current admin in\nplace. Admin-only.",
      "params": [
        {
          "name": "caller",
          "ty": "Address"
        }
      ],
      "returns": "()"
    },
    {
      "name": "get_admin",
      "doc": "",
      "params": [],
      "returns": "Address"
    },
    {
      "name": "get_pending_admin",
      "doc": "",
      "params": [],
      "returns": "Option<Address>"
    },
    {
      "name": "get_fee_bps",
      "doc": "",
      "params": [],
      "returns": "u32"
    },
    {
      "name": "get_fee_collector",
      "doc": "",
      "params": [],
      "returns": "Option<Address>"
    },
    {
      "name": "get_fee_balance",
      "doc": "",
      "params": [],
      "returns": "i128"
    },
    {
      "name": "preview_fee",
      "doc": "Computes `(fee, net)` for `amount` at `bps` without touching storage.\nExposed read-only so off-chain callers (SDKs, indexers, tests) can\npreview the exact split the contract will apply.",
      "params": [
        {
          "name": "amount",
          "ty": "i128"
        },
        {
          "name": "bps",
          "ty": "u32"
        }
      ],
      "returns": "(i128, i128)"
    }
  ],
  "errors": [
    {
      "name": "AlreadyInitialized",
      "code": 1
    },
    {
      "name": "NotInitialized",
      "code": 2
    },
    {
      "name": "InvalidAmount",
      "code": 3
    },
    {
      "name": "NothingToWithdraw",
      "code": 4
    },
    {
      "name": "InvalidOperator",
      "code": 5
    },
    {
      "name": "OperatorExpired",
      "code": 6
    },
    {
      "name": "InsufficientAllowance",
      "code": 7
    },
    {
      "name": "PendingPayoutChangeActive",
      "code": 8
    },
    {
      "name": "NoPendingPayoutChange",
      "code": 9
    },
    {
      "name": "InvalidTarget",
      "code": 10
    },
    {
      "name": "NotAdmin",
      "code": 11
    },
    {
      "name": "NotPendingAdmin",
      "code": 12
    },
    {
      "name": "NoPendingAdminProposal",
      "code": 13
    },
    {
      "name": "InvalidFee",
      "code": 14
    },
    {
      "name": "FeeOverflow",
      "code": 15
    },
    {
      "name": "NotFeeCollector",
      "code": 16
    }
  ]
}